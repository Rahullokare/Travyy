# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# Travyy API for AI extraction (see server/). Leave empty to run fully on-device.
EXPO_PUBLIC_API_URL=

# MapLibre style for the web map. Defaults to OpenFreeMap (free, no key).
EXPO_PUBLIC_MAP_STYLE_URL=

# Supabase project for sign-in (Project Settings → API). The anon key is public by design;
# never put the service_role key here. Leave empty for an app without accounts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Build-time only (not bundled): app variant.
# APP_VARIANT=development
