# AI extraction for /extract. Set at least one key; providers are tried in AI_PROVIDERS order and
# ones without a key are skipped. With no key /extract returns 503 and the app parses on-device.
# Gemini (free): key from https://aistudio.google.com/apikey. Free-tier data may be used by Google.
GEMINI_API_KEY=
# Gemini models to try in order (the next is used when one is overloaded or retired).
# Free-tier capacity varies by model; check with: bash server/scripts/gemini-check.sh
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview
# Groq (free): key from https://console.groq.com/keys. Fallback when Gemini is down or rate-limited.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Claude (paid per use, optional).
ANTHROPIC_API_KEY=
AI_PROVIDERS=gemini,groq,claude
PORT=8787
# Comma-separated web origins allowed to call the API ("*" for any). Native apps are unaffected.
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_HOUR=60
# Supabase project URL. Requests with a valid user token are limited per account instead of per IP.
# Only the project's public signing keys are read; no Supabase secret is needed.
SUPABASE_URL=
# Nominatim usage policy: identify your app with a contact address.
GEOCODER_USER_AGENT=Travyy/1.0 (you@example.com)

# Read Instagram captions from the public embed page (unofficial; see docs/ARCHITECTURE.md 9b).
# Set to "off" to disable instantly if Instagram objects or the page format breaks.
INSTAGRAM_CAPTIONS=on

# Let Gemini watch the post's video when the caption is weak: public YouTube links directly,
# Instagram reel clips (≤12 MB) downloaded from the CDN link the phone read. "off" disables both.
VIDEO_EXTRACTION=on
